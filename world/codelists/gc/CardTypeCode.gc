   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>DEBIT</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Debit card</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Kuzhek krul</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Taketa lasumu</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Each payment is debited from the holder's account at once.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>CREDIT</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Credit card</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Ruzzhul krul</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Tetela lasumu</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Payments are collected on a credit line and settled periodically.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>PREPAID</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Prepaid card</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Menrek krul</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Levati lasumu</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Payments are taken from an amount loaded onto the card in advance.</SimpleValue>
         </Value>
