<?xml version="1.0" encoding="UTF-8"?>
<!-- A world copy of UBL's default list DocumentStatus-2.1 (https://docs.oasis-open.org/ubl/os-UBL-2.1/cl/gc/default/DocumentStatusCode-2.1.gc), with the same codes, given a listID: UBL's own list has none, or one that an instance cannot quote. Made by tools/build_codelists.py from world/codelists/lists.json. -->
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
   <Identification>
      <ShortName>DocumentStatusCode</ShortName>
      <LongName xml:lang="en">Document status (UBL example world)</LongName>
      <LongName Identifier="listID">urn:oasis:names:specification:ubl:codelist:gc:DocumentStatusCode</LongName>
      <Version>2.1</Version>
      <CanonicalUri>urn:oasis:names:specification:ubl:codelist:gc:DocumentStatusCode</CanonicalUri>
      <CanonicalVersionUri>urn:oasis:names:specification:ubl:codelist:gc:DocumentStatusCode:2.1</CanonicalVersionUri>
      <LocationUri>https://kduvekot.github.io/ubl-examples/codelists/gc/DocumentStatusCode.gc</LocationUri>
      <Agency>
         <LongName xml:lang="en">OASIS Universal Business Language (UBL) TC</LongName>
      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="code" Use="required">
         <ShortName>Code</ShortName>
         <Data Type="normalizedString" />
      </Column>
      <Column Id="name" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Column Id="description" Use="optional">
         <ShortName>Description</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Key Id="codeKey">
         <ShortName>CodeKey</ShortName>
         <ColumnRef Ref="code" />
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>Cancelled</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Document has been cancelled</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>Completed</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Document has been completed</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>Confirmed</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Document has been confirmed</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>Disputed</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Document is disputed</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>NoStatus</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>No status on document</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>NotConfirmed</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Document has not been confirmed</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>Rejected</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Document has been rejected</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>Revised</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Document has been revised</SimpleValue>
         </Value>
      </Row>
   </SimpleCodeList>
</gc:CodeList>
