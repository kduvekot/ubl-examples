      <CanonicalUri>urn:ubl-examples:world:codelist:TransportEmergencyCardCode</CanonicalUri>
      <CanonicalVersionUri>urn:ubl-examples:world:codelist:TransportEmergencyCardCode:1.0</CanonicalVersionUri>
