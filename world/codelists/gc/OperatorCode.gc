<?xml version="1.0" encoding="UTF-8"?>
<!-- A world copy of UBL's default list Operator-2.0 (https://docs.oasis-open.org/ubl/os-UBL-2.0/cl/gc/default/OperatorCode-2.0.gc), with the same codes, given a listID: UBL's own list has none, or one that an instance cannot quote. Made by tools/build_codelists.py from world/codelists/lists.json. -->
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
   <Identification>
      <ShortName>OperatorCode</ShortName>
      <LongName xml:lang="en">Operator (UBL example world)</LongName>
      <LongName Identifier="listID">urn:oasis:names:specification:ubl:codelist:gc:OperatorCode</LongName>
      <Version>2.0</Version>
      <CanonicalUri>urn:oasis:names:specification:ubl:codelist:gc:OperatorCode</CanonicalUri>
      <CanonicalVersionUri>urn:oasis:names:specification:ubl:codelist:gc:OperatorCode:2.0</CanonicalVersionUri>
      <LocationUri>https://kduvekot.github.io/ubl-examples/codelists/gc/OperatorCode.gc</LocationUri>
      <Agency>
         <LongName xml:lang="en">OASIS Universal Business Language (UBL) TC</LongName>
      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="code" Use="required">
         <ShortName>Code</ShortName>
         <Data Type="normalizedString" />
      </Column>
      <Column Id="name" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Column Id="description" Use="optional">
         <ShortName>Description</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Key Id="codeKey">
         <ShortName>CodeKey</ShortName>
         <ColumnRef Ref="code" />
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>Divide</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Divide</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>Multiply</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Multiply</SimpleValue>
         </Value>
      </Row>
   </SimpleCodeList>
</gc:CodeList>
