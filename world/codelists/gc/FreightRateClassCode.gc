         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Freight all kinds</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Musaz sul zhemir</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Miipa menafe nivuni</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>One rate, whatever the goods.</SimpleValue>
