      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>BOX</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Rate per container</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Trazzhek ginek titran</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Kalala tatata napiali</SimpleValue>
         </Value>
         <Value ColumnRef="description">
