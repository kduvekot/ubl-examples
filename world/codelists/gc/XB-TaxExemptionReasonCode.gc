            <SimpleValue>Goods or services sent to a buyer outside Bayvarra.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>WATER</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Drinking water</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Drinking water supplied through the mains is exempt.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>PUBLIC</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Sale to a public body</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>A body of the federation, a state or a city buys free of sales tax.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>SVCB2B</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Service to a business</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>A service supplied to a business is not a retail sale.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>RESALE</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Sale for resale or manufacture</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>The buyer resells the goods or uses them in its products and charges the tax on its own retail sale.</SimpleValue>
