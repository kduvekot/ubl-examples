      <Column Id="name-qal" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="qal" />
      </Column>
      <Column Id="description" Use="optional">
         <ShortName>Description</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Key Id="codeKey">
         <ShortName>CodeKey</ShortName>
         <ColumnRef Ref="code" />
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>LUMECARD</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Lumecard</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Lumecard</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Lumecard</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>The domestic debit card scheme of Bayvarra's banks, like Interac or Girocard; chip application provider D902000001.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>CORALCARD</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Coralcard</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Coralcard</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Coralcard</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>The island's card scheme, settled on the coral ledger of the Bank of Selanu; chip application provider D903000001.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>TRESSACARD</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Tressa</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
