<?xml version="1.0" encoding="UTF-8"?>
<!-- A world copy of ISO 20022 ExternalServiceLevel1Code: the codes the world uses, and others of the same list. No machine-readable copy of the source could be kept (ISO 20022 external code sets, iso20022.org (blocked for automated access, 403)); the codes and names are as the standard publishes them. Made by tools/build_codelists.py from world/codelists/lists.json. -->
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
   <Identification>
      <ShortName>ISO20022ServiceLevelCode</ShortName>
      <LongName xml:lang="en">ISO 20022 ExternalServiceLevel1Code (UBL example world)</LongName>
      <LongName Identifier="listID">ISO 20022 ExternalServiceLevel1Code</LongName>
      <Version>as published by the ISO 20022 RA</Version>
      <CanonicalUri>urn:ubl-examples:world:codelist:copy:ISO20022ServiceLevelCode</CanonicalUri>
      <CanonicalVersionUri>urn:ubl-examples:world:codelist:copy:ISO20022ServiceLevelCode:as published by the ISO 20022 RA</CanonicalVersionUri>
      <LocationUri>https://kduvekot.github.io/ubl-examples/codelists/gc/ISO20022ServiceLevelCode.gc</LocationUri>
      <Agency>
         <LongName xml:lang="en">ISO 20022 Registration Authority (SWIFT)</LongName>
      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="code" Use="required">
         <ShortName>Code</ShortName>
         <Data Type="normalizedString" />
      </Column>
      <Column Id="name" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Column Id="description" Use="optional">
         <ShortName>Description</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Key Id="codeKey">
         <ShortName>CodeKey</ShortName>
         <ColumnRef Ref="code" />
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>NURG</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>NonUrgentPayment</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Payment must be executed as a non-urgent transaction, which is not to be processed by a real-time gross settlement system.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>URGP</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>UrgentPayment</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Payment must be executed as an urgent transaction cleared through a real-time gross settlement system.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>SDVA</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>SameDayValue</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Payment must be executed with same day value to the creditor.</SimpleValue>
         </Value>
      </Row>
   </SimpleCodeList>
</gc:CodeList>
