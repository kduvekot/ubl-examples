   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>CAO</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Cargo aircraft only</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Nirrir gardran hanvek</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Faleka hefale kasata</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>The goods may be carried on cargo aircraft only.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>PCA</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Passenger and cargo aircraft</SimpleValue>
