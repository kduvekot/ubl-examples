<?xml version="1.0" encoding="UTF-8"?>
<!-- A code list of the UBL example world: price type. The kind of a price, as both buyer and seller understand it, and whether it includes tax. Every price type of the world is a price before tax: the seller's tax is added on the invoice, and a consumer's tax at the sale (Bayvarra's sales tax at the till). Made by tools/build_codelists.py from world/codelists/lists.json. -->
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
   <Identification>
      <ShortName>PriceTypeCode</ShortName>
      <LongName xml:lang="en">Price type (UBL example world)</LongName>
      <LongName Identifier="listID">urn:ubl-examples:world:codelist:PriceTypeCode</LongName>
      <Version>1.0</Version>
      <CanonicalUri>urn:ubl-examples:world:codelist:PriceTypeCode</CanonicalUri>
      <CanonicalVersionUri>urn:ubl-examples:world:codelist:PriceTypeCode:1.0</CanonicalVersionUri>
      <LocationUri>https://kduvekot.github.io/ubl-examples/codelists/gc/PriceTypeCode.gc</LocationUri>
      <Agency>
         <LongName xml:lang="en">Lumeport Trade Accord</LongName>
      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="code" Use="required">
         <ShortName>Code</ShortName>
         <Data Type="normalizedString" />
      </Column>
      <Column Id="name" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Column Id="name-qau" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="qau" />
      </Column>
      <Column Id="name-qal" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="qal" />
      </Column>
      <Column Id="description" Use="optional">
         <ShortName>Description</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Column Id="tax-included" Use="required">
         <ShortName>TaxIncluded</ShortName>
         <Data Type="boolean" />
      </Column>
      <Key Id="codeKey">
         <ShortName>CodeKey</ShortName>
         <ColumnRef Ref="code" />
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>TRD</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Trade price</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Rizir mustek</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Tipiki lanasu</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>A price for resellers, before tax.</SimpleValue>
         </Value>
         <Value ColumnRef="tax-included">
            <SimpleValue>false</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>DST</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Distributor price</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Guldran mustek</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Kelokifi lanasu</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>The maker's price for its appointed distributor under a distribution agreement, below its list price; before tax.</SimpleValue>
         </Value>
         <Value ColumnRef="tax-included">
            <SimpleValue>false</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>RRP</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Recommended retail price</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Vazhan stekraz mustek</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Mianaki pamasa lanasu</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>The price the maker recommends for consumers, before tax; the shop adds the tax its country levies on a sale to a consumer.</SimpleValue>
         </Value>
         <Value ColumnRef="tax-included">
            <SimpleValue>false</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>CAT</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Catalogue price</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Zukkir mustek</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Katetaku lanasu</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>The price in the seller's general catalogue: its list price, before tax.</SimpleValue>
         </Value>
         <Value ColumnRef="tax-included">
            <SimpleValue>false</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>CON</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Contract price</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Baman mustek</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Hupeme lanasu</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>The price agreed in a contract, such as a framework contract, before tax.</SimpleValue>
         </Value>
         <Value ColumnRef="tax-included">
            <SimpleValue>false</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>PRO</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Promotional price</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Trezhan mustek</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Leelii lanasu</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>A price for a limited time, before tax.</SimpleValue>
         </Value>
         <Value ColumnRef="tax-included">
            <SimpleValue>false</SimpleValue>
         </Value>
      </Row>
   </SimpleCodeList>
</gc:CodeList>
