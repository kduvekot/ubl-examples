<?xml version="1.0" encoding="UTF-8"?>
<!-- A world copy of IMO INF Code ship class: the codes the world uses, and others of the same list. No machine-readable copy of the source could be kept (International Code for the Safe Carriage of Packaged Irradiated Nuclear Fuel, Plutonium and High-Level Radioactive Wastes on board Ships (INF Code), resolution MSC.88(71), 1.1.2); the codes and names are as the standard publishes them. Made by tools/build_codelists.py from world/codelists/lists.json. -->
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
   <Identification>
      <ShortName>IMOINFCode</ShortName>
      <LongName xml:lang="en">IMO INF Code ship class (UBL example world)</LongName>
      <LongName Identifier="listID">IMO INF Code</LongName>
      <Version>INF Code (SOLAS chapter VII, part D)</Version>
      <CanonicalUri>urn:ubl-examples:world:codelist:copy:IMOINFCode</CanonicalUri>
      <CanonicalVersionUri>urn:ubl-examples:world:codelist:copy:IMOINFCode:INF Code (SOLAS chapter VII, part D)</CanonicalVersionUri>
      <LocationUri>https://kduvekot.github.io/ubl-examples/codelists/gc/IMOINFCode.gc</LocationUri>
      <Agency>
         <LongName xml:lang="en">International Maritime Organization</LongName>
      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="code" Use="required">
         <ShortName>Code</ShortName>
         <Data Type="normalizedString" />
      </Column>
      <Column Id="name" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Column Id="description" Use="optional">
         <ShortName>Description</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Key Id="codeKey">
         <ShortName>CodeKey</ShortName>
         <ColumnRef Ref="code" />
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>INF1</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Class INF 1 ship</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Ships which are certified to carry INF cargo with an aggregate activity less than 4,000 TBq. The Code writes "Class INF 1"; the code leaves out the space.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>INF2</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Class INF 2 ship</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Ships which are certified to carry irradiated nuclear fuel or high-level radioactive wastes with an aggregate activity less than 2 × 10^6 TBq and ships which are certified to carry plutonium with an aggregate activity less than 2 × 10^5 TBq.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>INF3</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Class INF 3 ship</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Ships which are certified to carry irradiated nuclear fuel or high-level radioactive wastes and ships which are certified to carry plutonium with no restriction of the maximum aggregate activity of the materials.</SimpleValue>
         </Value>
      </Row>
   </SimpleCodeList>
</gc:CodeList>
