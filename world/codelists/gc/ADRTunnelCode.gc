      <CanonicalUri>urn:ubl-examples:world:codelist:copy:ADRTunnelCode</CanonicalUri>
      <CanonicalVersionUri>urn:ubl-examples:world:codelist:copy:ADRTunnelCode:ADR 2025</CanonicalVersionUri>
