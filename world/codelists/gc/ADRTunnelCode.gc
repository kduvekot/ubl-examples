            <SimpleValue>B1000C</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Above 1,000 kg net explosive mass: passage forbidden through B, C, D and E; below: through C, D and E.</SimpleValue>
         </Value>
      </Row>
