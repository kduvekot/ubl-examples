<?xml version="1.0" encoding="UTF-8"?>
<!-- A world copy of ADR tunnel restriction code: the codes the world uses, and others of the same list. No machine-readable copy of the source could be kept (ADR 8.6.4 and the tunnel restriction codes of column 15 of Table A, 3.2.1 (the slash is ADR's own notation)); the codes and names are as the standard publishes them. Made by tools/build_codelists.py from world/codelists/lists.json. -->
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
   <Identification>
