<?xml version="1.0" encoding="UTF-8"?>
<!-- A code list of the UBL example world: temperature class. The class of temperature goods are to be kept or carried at, where a document asks for the class and gives no figure: the carrier or the warehouse sets the figure the goods need within the class. -->
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
   <Identification>
      <ShortName>TemperatureClassCode</ShortName>
      <LongName xml:lang="en">Temperature class (UBL example world)</LongName>
      <LongName Identifier="listID">urn:ubl-examples:world:codelist:TemperatureClassCode</LongName>
      <Version>1.0</Version>
      <CanonicalUri>urn:ubl-examples:world:codelist:TemperatureClassCode</CanonicalUri>
      <CanonicalVersionUri>urn:ubl-examples:world:codelist:TemperatureClassCode:1.0</CanonicalVersionUri>
      <LocationUri>https://kduvekot.github.io/ubl-examples/codelists/gc/TemperatureClassCode.gc</LocationUri>
      <Agency>
         <LongName xml:lang="en">Lumeport Trade Accord</LongName>
      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="code" Use="required">
         <ShortName>Code</ShortName>
         <Data Type="normalizedString" />
      </Column>
      <Column Id="name" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Column Id="name-qau" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="qau" />
      </Column>
      <Column Id="name-qal" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="qal" />
      </Column>
      <Column Id="description" Use="optional">
         <ShortName>Description</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Key Id="codeKey">
         <ShortName>CodeKey</ShortName>
         <ColumnRef Ref="code" />
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>CHILLED</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Chilled</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Trerir</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Hinola</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Kept cold above freezing, at about 0 to 5 °C, as fresh fruit, vegetables, meat and dairy products are.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>FROZEN</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Frozen</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Gatrek</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Konoti</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Kept frozen, at -18 °C or colder.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>AMBIENT</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Ambient</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Kulhek</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Venalo</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Not temperature-controlled: kept at the temperature of its surroundings, protected from frost and heat.</SimpleValue>
         </Value>
      </Row>
   </SimpleCodeList>
</gc:CodeList>
