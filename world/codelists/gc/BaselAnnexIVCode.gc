<?xml version="1.0" encoding="UTF-8"?>
<!-- A world copy of Basel Convention, Annex IV: disposal and recovery operations: the codes the world uses, and others of the same list. No machine-readable copy of the source could be kept (Basel Convention on the Control of Transboundary Movements of Hazardous Wastes and their Disposal, Annex IV); the codes and names are as the standard publishes them. Made by tools/build_codelists.py from world/codelists/lists.json. -->
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
   <Identification>
      <ShortName>BaselAnnexIVCode</ShortName>
      <LongName xml:lang="en">Basel Convention, Annex IV: disposal and recovery operations (UBL example world)</LongName>
      <LongName Identifier="listID">Basel Convention Annex IV</LongName>
      <Version>Basel Convention as amended</Version>
      <CanonicalUri>urn:ubl-examples:world:codelist:copy:BaselAnnexIVCode</CanonicalUri>
      <CanonicalVersionUri>urn:ubl-examples:world:codelist:copy:BaselAnnexIVCode:Basel Convention as amended</CanonicalVersionUri>
      <LocationUri>https://kduvekot.github.io/ubl-examples/codelists/gc/BaselAnnexIVCode.gc</LocationUri>
      <Agency>
         <LongName xml:lang="en">Secretariat of the Basel Convention (UNEP)</LongName>
      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="code" Use="required">
         <ShortName>Code</ShortName>
         <Data Type="normalizedString" />
      </Column>
      <Column Id="name" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Column Id="description" Use="optional">
         <ShortName>Description</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Key Id="codeKey">
         <ShortName>CodeKey</ShortName>
         <ColumnRef Ref="code" />
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>D1</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Deposit into or onto land (e.g. landfill)</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>D10</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Incineration on land</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>R1</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Use principally as a fuel or other means to generate energy</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>R2</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Solvent reclamation/regeneration</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>R3</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Recycling/reclamation of organic substances which are not used as solvents</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>R4</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Recycling/reclamation of metals and metal compounds</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>R5</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Recycling/reclamation of other inorganic materials</SimpleValue>
         </Value>
      </Row>
   </SimpleCodeList>
</gc:CodeList>
