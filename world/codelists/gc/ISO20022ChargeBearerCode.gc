   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>DEBT</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>BorneByDebtor</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>All transaction charges are to be borne by the debtor.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>CRED</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>BorneByCreditor</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>All transaction charges are to be borne by the creditor.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>SHAR</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Shared</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Transaction charges on the sender side are to be borne by the debtor, on the receiver side by the creditor.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>SLEV</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>FollowingServiceLevel</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Charges are to be applied following the rules agreed in the service level.</SimpleValue>
         </Value>
      </Row>
