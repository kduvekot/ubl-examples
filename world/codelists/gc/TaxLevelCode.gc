         <ShortName>Code</ShortName>
         <Data Type="normalizedString" />
      </Column>
      <Column Id="name" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Column Id="name-qau" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="qau" />
      </Column>
      <Column Id="name-qal" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="qal" />
      </Column>
      <Column Id="description" Use="optional">
         <ShortName>Description</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Key Id="codeKey">
         <ShortName>CodeKey</ShortName>
         <ColumnRef Ref="code" />
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>NATIONAL</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Levied by the country</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Dredrir man drek trakhek</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Vukika ninote kuuva</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>A tax of the country as a whole, such as Urvania's value added tax.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>STATE</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Levied by a state or territory</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Dredrir man sir zutir van runran</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Vukika ninote kileva vapene laliafo</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>A tax of a state or a federal territory, such as Bayvarra's state sales tax.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>LOCAL</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Levied by a city or municipality</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Dredrir man sir skek van starstir</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Vukika ninote mipeki vapene polutepa</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>A local tax or levy, such as a city's sewage levy.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>ACCORD</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Levied under the Trade Accord</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Dredrir karul drek Trade Accord</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Vukika tilala Trade Accord</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>A charge the Trade Accord's member states levy jointly.</SimpleValue>
         </Value>
      </Row>
   </SimpleCodeList>
