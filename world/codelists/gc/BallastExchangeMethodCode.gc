   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>SEQ</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Sequential</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Hazaz</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Vafolale</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>The tank is emptied and refilled with open-sea water.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>FLOW</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Flow-through</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Drekkrir-tralzan</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Tihohe-lepimi</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Open-sea water is pumped through the tank, three times its volume.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>DIL</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Dilution</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Sardir</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Hafove</SimpleValue>
         </Value>
         <Value ColumnRef="description">
