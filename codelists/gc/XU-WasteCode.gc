<?xml version="1.0" encoding="UTF-8"?>
<!-- A code list of the UBL example world: waste list. Urvania's national list of waste, under its waste law: it takes over the entries and the six-digit numbers of the European List of Waste (Commission Decision 2000/532/EC, as amended by Decision 2014/955/EU), whose rules for choosing an entry it also follows: first the chapter of the activity that produces the waste (01 to 12, 17 to 20), then chapters 13 to 15, then 16. The world holds the entries for packaging waste (15 01); a code is written without the spaces of the printed list. Made by tools/build_codelists.py from world/codelists/lists.json. -->
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
   <Identification>
      <ShortName>WasteCode</ShortName>
      <LongName xml:lang="en">Waste list (UBL example world)</LongName>
      <LongName Identifier="listID">urn:ubl-examples:world:XU:codelist:WasteCode</LongName>
      <Version>1.0</Version>
      <CanonicalUri>urn:ubl-examples:world:XU:codelist:WasteCode</CanonicalUri>
      <CanonicalVersionUri>urn:ubl-examples:world:XU:codelist:WasteCode:1.0</CanonicalVersionUri>
      <LocationUri>https://kduvekot.github.io/ubl-examples/codelists/gc/XU-WasteCode.gc</LocationUri>
      <Agency>
         <LongName xml:lang="en">Government of Urvania</LongName>
      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="code" Use="required">
         <ShortName>Code</ShortName>
         <Data Type="normalizedString" />
      </Column>
      <Column Id="name" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Column Id="name-qau" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="qau" />
      </Column>
      <Column Id="description" Use="optional">
         <ShortName>Description</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Key Id="codeKey">
         <ShortName>CodeKey</ShortName>
         <ColumnRef Ref="code" />
      </Key>
   </ColumnSet>
