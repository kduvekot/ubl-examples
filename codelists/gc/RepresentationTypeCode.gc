   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>OWN</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>On its own behalf</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Rek nakskek hirmek dunek</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Lelala pehaka tavase hokake</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>BEHALF</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>On behalf of other authorities</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Rek dunek skul skuznan rinaz</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Lelala hokake mutaki vimemi ketometi</SimpleValue>
         </Value>
