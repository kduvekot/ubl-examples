<?xml version="1.0" encoding="UTF-8"?>
<!-- A world copy of UBL's default list ReceiptAdviceType-2.1 (https://docs.oasis-open.org/ubl/os-UBL-2.1/cl/gc/default/ReceiptAdviceTypeCode-2.1.gc), with the same codes, given a listID: UBL's own list has none, or one that an instance cannot quote. Made by tools/build_codelists.py from world/codelists/lists.json. -->
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
   <Identification>
      <ShortName>ReceiptAdviceTypeCode</ShortName>
      <LongName xml:lang="en">Receipt advice type (UBL example world)</LongName>
      <LongName Identifier="listID">urn:oasis:names:specification:ubl:codelist:gc:ReceiptAdviceTypeCode</LongName>
      <Version>2.1</Version>
      <CanonicalUri>urn:oasis:names:specification:ubl:codelist:gc:ReceiptAdviceTypeCode</CanonicalUri>
      <CanonicalVersionUri>urn:oasis:names:specification:ubl:codelist:gc:ReceiptAdviceTypeCode:2.1</CanonicalVersionUri>
      <LocationUri>https://kduvekot.github.io/ubl-examples/codelists/gc/ReceiptAdviceTypeCode.gc</LocationUri>
      <Agency>
         <LongName xml:lang="en">OASIS Universal Business Language (UBL) TC</LongName>
      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="code" Use="required">
         <ShortName>Code</ShortName>
         <Data Type="normalizedString" />
      </Column>
      <Column Id="name" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Column Id="description" Use="optional">
         <ShortName>Description</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Key Id="codeKey">
         <ShortName>CodeKey</ShortName>
         <ColumnRef Ref="code" />
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>Actual</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>An arrival that has passed goods inspection and is accepted (or not).</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>Preliminary</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>An arrival that has not passed the goods inspection process.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>Return</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Receipt of goods that are returned back from the buyer (e.g. customer returns).</SimpleValue>
         </Value>
      </Row>
   </SimpleCodeList>
</gc:CodeList>
