   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>CMR</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Road consignment note (CMR)</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Kraz silsan mek (CMR)</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Natii lutatehi tamasu (CMR)</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>A consignment note under the Convention on the Contract for the International Carriage of Goods by Road (UN/EDIFACT 1001: 730).</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
