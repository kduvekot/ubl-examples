<?xml version="1.0" encoding="UTF-8"?>
<!-- A code list of the UBL example world: wood. The wood an item is made of, as a code: the variants of furniture made in more than one wood. -->
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
   <Identification>
      <ShortName>WoodCode</ShortName>
      <LongName xml:lang="en">Wood (UBL example world)</LongName>
      <LongName Identifier="listID">urn:ubl-examples:world:codelist:WoodCode</LongName>
      <Version>1.0</Version>
      <CanonicalUri>urn:ubl-examples:world:codelist:WoodCode</CanonicalUri>
      <CanonicalVersionUri>urn:ubl-examples:world:codelist:WoodCode:1.0</CanonicalVersionUri>
      <LocationUri>https://kduvekot.github.io/ubl-examples/codelists/gc/WoodCode.gc</LocationUri>
      <Agency>
         <LongName xml:lang="en">Lumeport Trade Accord</LongName>
      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="code" Use="required">
         <ShortName>Code</ShortName>
         <Data Type="normalizedString" />
      </Column>
      <Column Id="name" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Column Id="name-qau" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="qau" />
      </Column>
      <Column Id="name-qal" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="qal" />
      </Column>
      <Column Id="description" Use="optional">
         <ShortName>Description</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Key Id="codeKey">
         <ShortName>CodeKey</ShortName>
         <ColumnRef Ref="code" />
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>OAK</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Oak</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Kenkrir</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Fofasu</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Oak, as the Marrow bench and chair in solid kiln-dried oak.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>ASH</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Ash</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Darhir</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Lalaki</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Ash, as the Marrow bench and chair in solid kiln-dried ash.</SimpleValue>
         </Value>
      </Row>
   </SimpleCodeList>
</gc:CodeList>
