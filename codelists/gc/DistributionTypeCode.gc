<?xml version="1.0" encoding="UTF-8"?>
<!-- A code list of the UBL example world: distribution type. How a party receives a distributed document: whether it gets an original or a copy, and how it is sent, following the examples of UBL's definition of DistributionTypeCode ("Collect", "Sent by courier", "Sent scanned copy"). UBL 2.5 deprecated CopyIndicator, MaximumCopiesNumeric, MaximumOriginalsNumeric and PrintQualifier, so original or copy is said here, not in DocumentTypeCode, which gives the type of the distributed document. Made by tools/build_codelists.py from world/codelists/lists.json. -->
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
   <Identification>
      <ShortName>DistributionTypeCode</ShortName>
      <LongName xml:lang="en">Distribution type (UBL example world)</LongName>
      <LongName Identifier="listID">urn:ubl-examples:world:codelist:DistributionTypeCode</LongName>
      <Version>1.0</Version>
      <CanonicalUri>urn:ubl-examples:world:codelist:DistributionTypeCode</CanonicalUri>
      <CanonicalVersionUri>urn:ubl-examples:world:codelist:DistributionTypeCode:1.0</CanonicalVersionUri>
      <LocationUri>https://kduvekot.github.io/ubl-examples/codelists/gc/DistributionTypeCode.gc</LocationUri>
      <Agency>
         <LongName xml:lang="en">Lumeport Trade Accord</LongName>
      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="code" Use="required">
         <ShortName>Code</ShortName>
         <Data Type="normalizedString" />
      </Column>
      <Column Id="name" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Column Id="name-qau" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="qau" />
      </Column>
      <Column Id="name-qal" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="qal" />
      </Column>
      <Column Id="description" Use="optional">
         <ShortName>Description</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Key Id="codeKey">
         <ShortName>CodeKey</ShortName>
         <ColumnRef Ref="code" />
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>ORIGINALCOURIER</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Original, sent by courier</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Rikzhek, hastir man barkraz</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Folue, teketi ninote pakali</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>An original on paper, sent to the party by courier.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>ORIGINALWITHGOODS</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Original, with the goods</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Rikzhek, vek drek valnir</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Folue, tofuta liape</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>An original on paper that travels with the goods to the party, as the transport conventions prescribe for one original of a consignment note.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>COLLECT</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Collect</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Ranaz</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Hamane</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>The party collects the original on paper at the issuer's office.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>SCANNEDCOPY</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Scanned copy</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Buzrek zuzzir</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Tafeta tiveto</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>A copy of the paper original, scanned and sent electronically, for information.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>ELECTRONIC</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Electronic</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Viskir</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Tihetaki</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>The document itself, sent to the party as a UBL message.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>ELECTRONICCOPY</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Electronic copy</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Viskir zuzzir</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Tihetaki tiveto</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>A copy sent as a UBL message, for the party's information or records; the original is held or sent elsewhere.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>PORTAL</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Portal</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Sturstan</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Navuvi</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Made available to the party on a portal.</SimpleValue>
         </Value>
      </Row>
   </SimpleCodeList>
</gc:CodeList>
