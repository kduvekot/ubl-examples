<?xml version="1.0" encoding="UTF-8"?>
<!-- A code list of the UBL example world: import consumption tax exemption reason. Why goods imported into Lisavu carry no import consumption tax. The tax falls on every import whatever its origin; its exemptions are few and named here. Made by tools/build_codelists.py from world/codelists/lists.json. -->
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
   <Identification>
      <ShortName>TaxExemptionReasonCode</ShortName>
      <LongName xml:lang="en">Import consumption tax exemption reason (UBL example world)</LongName>
      <LongName Identifier="listID">urn:ubl-examples:world:XL:codelist:TaxExemptionReasonCode</LongName>
      <Version>1.0</Version>
      <CanonicalUri>urn:ubl-examples:world:XL:codelist:TaxExemptionReasonCode</CanonicalUri>
      <CanonicalVersionUri>urn:ubl-examples:world:XL:codelist:TaxExemptionReasonCode:1.0</CanonicalVersionUri>
      <LocationUri>https://kduvekot.github.io/ubl-examples/codelists/gc/XL-TaxExemptionReasonCode.gc</LocationUri>
      <Agency>
         <LongName xml:lang="en">Government of Lisavu</LongName>
      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="code" Use="required">
         <ShortName>Code</ShortName>
         <Data Type="normalizedString" />
      </Column>
      <Column Id="name" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Column Id="name-qal" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="qal" />
      </Column>
      <Column Id="description" Use="optional">
         <ShortName>Description</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Key Id="codeKey">
         <ShortName>CodeKey</ShortName>
         <ColumnRef Ref="code" />
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>MEDHOSP</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Medicines and vaccines for a public hospital</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Lifanaha tofami hatoki kifupa paveli pateta</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Medicines and vaccines supplied to a public hospital of Lisavu are exempt from the import consumption tax of 10 %, and so is their import for that supply; everything else imported carries the tax.</SimpleValue>
         </Value>
      </Row>
   </SimpleCodeList>
</gc:CodeList>
