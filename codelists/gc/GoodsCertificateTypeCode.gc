            <SimpleValue>Zizskan vurskek</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Pamataka kamepou</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Animals or animal products meet the importing country's health rules.</SimpleValue>
