         <Data Type="string" Lang="en" />
      </Column>
      <Key Id="codeKey">
         <ShortName>CodeKey</ShortName>
         <ColumnRef Ref="code" />
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>PHYTO</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Phytosanitary certificate</SimpleValue>
         </Value>
         <Value ColumnRef="name-qau">
            <SimpleValue>Zhulhan vurskek</SimpleValue>
         </Value>
         <Value ColumnRef="name-qal">
            <SimpleValue>Tatetope kamepou</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Plants or plant products are free of the pests the importing country names.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>VETERINARY</SimpleValue>
