   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>FRST</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>First</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>First collection of a series of direct debit instructions.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>RCUR</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Recurring</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Direct debit instruction where the debtor's authorisation is used for regular direct debit transactions initiated by the creditor.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>FNAL</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Final</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Final collection of a series of direct debit instructions.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>OOFF</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>OneOff</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Direct debit instruction where the debtor's authorisation is used to initiate one single direct debit transaction.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>RPRE</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Represented</SimpleValue>
         </Value>
         <Value ColumnRef="description">
