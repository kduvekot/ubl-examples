<?xml version="1.0" encoding="UTF-8"?>
<!-- A world copy of IMO IMDG Code emergency schedules (EmS): the codes the world uses, and others of the same list. No machine-readable copy of the source could be kept (IMDG Code, Dangerous Goods List column 15, as the BAM DGG-Info database gives it for UN 3480, 2920 and 2911 (the IMDG Code is a paid IMO publication)); the codes and names are as the standard publishes them. Made by tools/build_codelists.py from world/codelists/lists.json. -->
<gc:CodeList xmlns:gc="http://docs.oasis-open.org/codelist/ns/genericode/1.0/">
   <Identification>
      <ShortName>IMDGEmSCode</ShortName>
      <LongName xml:lang="en">IMO IMDG Code emergency schedules (EmS) (UBL example world)</LongName>
      <LongName Identifier="listID">IMO IMDG EmS</LongName>
      <Version>IMDG Code, Amendment 42-24</Version>
      <CanonicalUri>urn:ubl-examples:world:codelist:copy:IMDGEmSCode</CanonicalUri>
      <CanonicalVersionUri>urn:ubl-examples:world:codelist:copy:IMDGEmSCode:IMDG Code, Amendment 42-24</CanonicalVersionUri>
      <LocationUri>https://kduvekot.github.io/ubl-examples/codelists/gc/IMDGEmSCode.gc</LocationUri>
      <Agency>
         <LongName xml:lang="en">International Maritime Organization</LongName>
      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="code" Use="required">
         <ShortName>Code</ShortName>
         <Data Type="normalizedString" />
      </Column>
      <Column Id="name" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Column Id="description" Use="optional">
         <ShortName>Description</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Key Id="codeKey">
         <ShortName>CodeKey</ShortName>
         <ColumnRef Ref="code" />
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>F-A,S-I</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Fire schedule Alpha, spillage schedule India</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>General fire schedule; flammable solids. The IMDG Code writes F-A, S-I; the world's code leaves out the space.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>F-E,S-C</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Fire schedule Echo, spillage schedule Charlie</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Non-water-reactive flammable liquids; flammable, corrosive liquids.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>F-I,S-S</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Fire schedule India, spillage schedule Sierra</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Radioactive material.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>F-A,S-A</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Fire schedule Alpha, spillage schedule Alpha</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>General fire schedule; toxic substances.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>F-E,S-E</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Fire schedule Echo, spillage schedule Echo</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>Non-water-reactive flammable liquids; flammable liquids floating on water.</SimpleValue>
         </Value>
      </Row>
   </SimpleCodeList>
</gc:CodeList>
