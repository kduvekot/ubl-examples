      </Agency>
   </Identification>
   <ColumnSet>
      <Column Id="code" Use="required">
         <ShortName>Code</ShortName>
         <Data Type="normalizedString" />
      </Column>
      <Column Id="name" Use="required">
         <ShortName>Name</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Column Id="description" Use="optional">
         <ShortName>Description</ShortName>
         <Data Type="string" Lang="en" />
      </Column>
      <Key Id="codeKey">
         <ShortName>CodeKey</ShortName>
         <ColumnRef Ref="code" />
      </Key>
   </ColumnSet>
   <SimpleCodeList>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>XB-UL</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Upland State</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>A state, inland.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>XB-CO</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Coastal State</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>A state, on the coast around Lumeport.</SimpleValue>
         </Value>
      </Row>
      <Row>
         <Value ColumnRef="code">
            <SimpleValue>XB-NT</SimpleValue>
         </Value>
         <Value ColumnRef="name">
            <SimpleValue>Northern Territory</SimpleValue>
         </Value>
         <Value ColumnRef="description">
            <SimpleValue>A federal territory on the north coast, with its own rate of the state sales tax.</SimpleValue>
         </Value>
